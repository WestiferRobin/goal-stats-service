# GoalStats local development only. Docker Compose reads this file through Make.
# The password is deliberately non-production and PostgreSQL binds to loopback.
APP_PORT=5100
POSTGRES_PORT=55432
REDIS_PORT=56379
POSTGRES_PASSWORD=goalstats-local-development

OPENAPI_ENABLED=true
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300

# Optional. Manual predictions and bundled data do not require a provider key.
API_FOOTBALL_KEY=
